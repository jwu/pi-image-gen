{
  "name": "pi-image-gen",
  "version": "0.1.0",
  "private": true,
  "description": "Image generation tool for pi coding agent (Codex / Grok / OpenAI Images)",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./src/extension.ts"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",

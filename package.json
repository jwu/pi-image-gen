    "verify": "npm run typecheck && npm test && npm run smoke"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@types/bun": "latest",
    "typebox": "1.3.27",
    "typescript": "^5.9.0"
  }
}
